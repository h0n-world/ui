{
    "extends": "../../tsconfig.base.json",
    "include": [
        "vite.config.*",
        "vitest.config.*",
        "cypress.config.*",
        "playwright.config.*",
        "eslint.config.*",
        "scripts/**/*.ts"
    ],
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "lib": ["ES2022"],
        "types": ["node"],
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
    }
}
