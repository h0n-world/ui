{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
    "exclude": ["src/**/__tests__/*"],
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        // Extra safety for array and object lookups, but may have false positives.
        "noUncheckedIndexedAccess": false,

        // Path mapping for cleaner imports.
        "paths": {
            "@/*": ["./src/*"],
            "@h0nio/icons": ["../../packages/icons/src/index.ts"],
            "@h0nio/icons/all": ["../../packages/icons/src/all.ts"],
            "@h0nio/icons/catalog": ["../../packages/icons/src/catalog.ts"],
            "@h0nio/icons/runtime": ["../../packages/icons/src/runtime.ts"],
            "@h0nio/icons/types": ["../../packages/icons/src/types.ts"],
            "@h0nio/icons/*": ["../../packages/icons/src/icons/*.ts"],
            "@h0nio/ui/icons": ["../../packages/ui/src/icons/index.ts"],
            "@h0nio/ui": ["../../packages/ui/src/entry.ts"],
            "vue": ["./node_modules/vue"]
        },

        // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
        // Specified here to keep it out of the root directory.
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
    }
}
