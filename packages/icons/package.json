{
  "name": "@h0nio/icons",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic, tree-shakeable SVG icons for h0nio projects",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./svg/*": "./svg/*.svg",
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "scripts": {
    "import:duotone": "node scripts/import-duotone.mjs",
    "import:solid": "node scripts/import-solid.mjs",
    "import:stroke": "node scripts/import-stroke.mjs",
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsc -p tsconfig.json && node scripts/copy-svg.mjs",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-generated.mjs"
  },
  "devDependencies": {
    "svgo": "^4.0.0",
    "typescript": "^5.9.2"
  }
}
